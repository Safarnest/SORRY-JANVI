/* =========================================================
   OPENING
========================================================= */

const beginBtn = document.getElementById("beginBtn");
const opening = document.getElementById("opening");
const letter = document.getElementById("letter");

if (beginBtn && opening && letter) {

  beginBtn.addEventListener("click", () => {

    opening.classList.add("opening-exit");

    setTimeout(() => {

      letter.classList.add("letter-visible");

      window.scrollTo({
        top: letter.offsetTop,
        behavior: "smooth"
      });

    }, 700);

  });

}


/* =========================================================
   MEMORY REVEALS
========================================================= */

const memoryItems =
  document.querySelectorAll(".cinematic-memory");


if ("IntersectionObserver" in window) {

  const memoryObserver =
    new IntersectionObserver(
      (entries) => {

        entries.forEach((entry) => {

          if (entry.isIntersecting) {

            entry.target.classList.add(
              "memory-active"
            );

          }

        });

      },
      {
        threshold: 0.15
      }
    );


  memoryItems.forEach((item) => {
    memoryObserver.observe(item);
  });

} else {

  memoryItems.forEach((item) => {
    item.classList.add("memory-active");
  });

}


/* =========================================================
   ENVELOPE
========================================================= */

const openLetterBtn =
  document.getElementById("openLetterBtn");

const envelopeBox =
  document.getElementById("envelopeBox");

const heartLetter =
  document.getElementById("heartLetter");


if (openLetterBtn && envelopeBox && heartLetter) {

  openLetterBtn.addEventListener("click", () => {

    envelopeBox.classList.add(
      "envelope-opened"
    );

    openLetterBtn.classList.add(
      "hide-open-button"
    );


    setTimeout(() => {

      heartLetter.classList.add(
        "heart-letter-visible"
      );

      window.scrollTo({
        top: heartLetter.offsetTop,
        behavior: "smooth"
      });

    }, 1150);

  });

}


/* =========================================================
   WHATSAPP RESPONSE
   BUGGU × BUGGI
========================================================= */

const whatsappNumber =
  "918368875843";


const yesBtn =
  document.getElementById("yesBtn");

const timeBtn =
  document.getElementById("timeBtn");


function sendWhatsAppMessage(message) {

  const url =
    `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

  window.location.href = url;

}


/* ❤️ HAAN */

if (yesBtn) {

  yesBtn.addEventListener("click", () => {

    sendWhatsAppMessage(
      "❤️ Haan, main apne Buggu ko maaf karti hoon. 🥺❤️\n\n— Buggi 🦎"
    );

  });

}


/* 🥺 THODA TIME */

if (timeBtn) {

  timeBtn.addEventListener("click", () => {

    sendWhatsAppMessage(
      "🥺 Mujhe thoda time chahiye, Buggu. Main tumhari baat samajh rahi hoon. ❤️\n\n— Buggi 🦎"
    );

  });

}